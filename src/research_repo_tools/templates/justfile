# Retain these small wrappers in each consuming repository.
# Setup installs Just; recipes require a POSIX sh on PATH on every platform.
# Select dev explicitly, including when the consumer disables default groups.
set positional-arguments

# Generate, normalize, and rotate completed minor series into docs/archives/changelog.
changelog:
    uv run --locked --group dev research-repo-tools toolchain run -- research-repo-tools changelog generate

# Archive completed minor series without regenerating Git history.
changelog-archive:
    uv run --locked --group dev research-repo-tools changelog archive

# Validate the entire changelog and all archives without writing files.
changelog-check:
    uv run --locked --group dev research-repo-tools changelog check

# Generate, normalize, and rotate completed minor series without publishing files.
changelog-preview *args:
    uv run --locked --group dev research-repo-tools toolchain run -- research-repo-tools changelog generate --dry-run "$@"

# Generate and archive a prospective release with an explicit YYYY-MM-DD date.
changelog-release tag date:
    uv run --locked --group dev research-repo-tools toolchain run -- research-repo-tools changelog generate --tag {{quote(tag)}} --date {{quote(date)}}

alias changelog-unreleased := changelog-release

# Show command help when invoked without a recipe.
[default]
[private]
default: help

# List available commands and arguments in lexicographic order.
help:
    @just --justfile {{quote(justfile())}} --alias-style separate --list

alias help-workflows := help

# Validate structure, cell identities, and source output policy.
notebook-check +files:
    notebook_group="$(uv run --locked --only-group tooling --inexact research-repo-tools notebooks group)" && uv run --locked --group dev --group "$notebook_group" research-repo-tools notebooks check "$@"

# Deliberately clear generated notebook outputs and execution metadata.
notebook-clear +files:
    notebook_group="$(uv run --locked --only-group tooling --inexact research-repo-tools notebooks group)" && uv run --locked --group dev --group "$notebook_group" research-repo-tools notebooks clear "$@"

# Execute only the selected notebooks in fresh project kernels.
notebook-execute +files:
    notebook_group="$(uv run --locked --only-group tooling --inexact research-repo-tools notebooks group)" && uv run --locked --group dev --group "$notebook_group" research-repo-tools notebooks execute "$@"

# Check structure, Python syntax, Ruff rules/formatting, and ty types.
notebook-lint +files:
    notebook_group="$(uv run --locked --only-group tooling --inexact research-repo-tools notebooks group)" && uv run --locked --group dev --group "$notebook_group" research-repo-tools notebooks lint "$@"

# Synchronize the locked notebook environment and register its project kernel.
notebook-sync:
    uv run --locked --managed-python --only-group tooling research-repo-tools notebooks sync

# Check consumer release metadata.
release-check:
    uv run --locked --group dev research-repo-tools release check

# Print release notes from the root changelog or an archive.
release-notes tag:
    uv run --locked --group dev research-repo-tools changelog notes {{quote(tag)}}

# Review branch and local changes with CodeRabbit against a verified origin/main by default.
review base="origin/main":
    uv run --locked --group dev research-repo-tools review branch --base="$1"

# Review only staged, unstaged, and non-ignored untracked changes with CodeRabbit.
review-uncommitted:
    uv run --locked --group dev research-repo-tools review uncommitted

# Validate the consumer's Semgrep rules and fixtures.
semgrep-check:
    uv run --locked --group dev research-repo-tools semgrep check-fixtures

# Repeat the package setup after tool declarations change.
setup:
    uv run --locked --managed-python --only-group tooling research-repo-tools setup

# Create a local annotated tag using tag-release.
tag tag: (tag-release tag)

# Explicitly replace an existing local annotated tag.
tag-force tag:
    uv run --locked --group dev research-repo-tools changelog tag {{quote(tag)}} --force

# Create a local annotated tag from validated release notes.
tag-release tag:
    uv run --locked --group dev research-repo-tools changelog tag {{quote(tag)}}

# The environment must already exist; checking never syncs or downloads Python.
tools-check:
    uv run --locked --no-sync --no-python-downloads research-repo-tools toolchain check

# Upgrade uv and declared Cargo tools, update Python pins and locks, and sync.
update:
    uv run --no-config --no-sync --no-python-downloads research-repo-tools deps update-uv
    uv run --locked --group dev research-repo-tools deps update-python
    uv lock --upgrade
    uv run --locked --group dev research-repo-tools toolchain upgrade
    uv run --locked --managed-python --only-group tooling research-repo-tools setup

# Upgrade only declared managed Cargo tools and publish verified TOML pins.
update-cargo-tools:
    uv run --locked --group dev research-repo-tools toolchain upgrade

# Update exact direct Python development pins.
update-python-deps:
    uv run --locked --group dev research-repo-tools deps update-python
